# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Google Gemini API Key (optional, fallback catalogue enabled if empty)
GEMINI_API_KEY=

# Tenor v2 API Key (optional, curated fallback catalogue enabled if empty)
TENOR_API_KEY=

# Telegram Mini App URL (local or tunnel URL, e.g. https://your-tunnel.loca.lt)
WEBAPP_URL=http://127.0.0.1:8080

# Server configuration
HOST=127.0.0.1
PORT=8080

# Development mode (enables safe auth fallback for browser testing)
DEV_MODE=true
